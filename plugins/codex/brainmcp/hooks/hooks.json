{
  "description": "brainMCP orientation and opt-in session capture",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/dist/runtime/index.js\" codex SessionStart --from-plugin"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/dist/runtime/index.js\" codex UserPromptSubmit --from-plugin",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/dist/runtime/index.js\" codex PostToolUse --from-plugin",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/dist/runtime/index.js\" codex PreCompact --from-plugin",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/dist/runtime/index.js\" codex SessionEnd --from-plugin",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
